# --- webhook security ---
GITHUB_WEBHOOK_SECRET=

# --- bot identity ---
MONKEY_BOT_LOGIN=monkey
MONKEY_GIT_AUTHOR_NAME=monkey
MONKEY_GIT_AUTHOR_EMAIL=monkey@users.noreply.github.com

# --- scope (comma-separated owner/repo) ---
MONKEY_REPO_ALLOWLIST=acme/widget

# --- engine (pi) ---
MONKEY_MODEL=
MONKEY_THINKING=medium
MONKEY_PROVIDER=
MONKEY_SESSION_DIR=/data/sessions

# --- concurrency / limits ---
MONKEY_MAX_CONCURRENCY=8
# Auto-close `question` issues after N hours (default 4)
MONKEY_QUESTION_AUTOCLOSE_HOURS=4

# --- release sentinel (default OFF, pushes to main) ---
MONKEY_RELEASE_SENTINEL_ENABLED=false
MONKEY_RELEASE_MAX_ROUNDS=5

# --- storage (defaults match the containers; override for local CLI runs) ---
# Issue worktrees, used by the worker and `monkey cleanup` (default /data/workspaces)
MONKEY_WORKSPACES_ROOT=/data/workspaces
# SQLite database for `monkey serve` / `status` / `triage` (default /data/monkey.db)
MONKEY_DB_PATH=/data/monkey.db

# --- gh-proxy auth: choose ONE mode (Settings::validate rejects both) ---
# Mode 1: gh-proxy sidecar (recommended, 2-container trust boundary).
#   GITHUB_TOKEN is REQUIRED here - the gh-proxy container reads it. docker-compose
#   overrides GITHUB_TOKEN to empty for the orchestrator container, so it never
#   sees the token. The two proxy variables below must be set together.
MONKEY_GH_PROXY_URL=http://gh-proxy:8080
MONKEY_GH_PROXY_HMAC_KEY=
GITHUB_TOKEN=
# Mode 2: direct PAT - VALIDATION-ONLY today. Settings::validate accepts a
#   GITHUB_TOKEN-only config (leave both proxy variables above empty; do NOT set
#   them in this mode), but no code path sends direct PAT requests yet: all
#   GitHub calls go through the gh-proxy client, so the bot cannot write back
#   in this mode. Use Mode 1 until direct PAT support lands.
